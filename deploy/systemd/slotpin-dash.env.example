# Optional environment overrides for slotpin-dash.
# Copy to /etc/slotpin/slotpin-dash.env and edit. Every value has a built-in
# default and the dashboard runs with none of these set. The built-in defaults
# are: bind on loopback, energy off, no box switcher.
# The values below are examples; uncomment only what you need.

# --- network ---
# DASH_HOST=127.0.0.1               # interface to bind the dashboard on (default: loopback)
# DASH_PORT=8091

# --- data sources (must match the slotpin-proxy deployment) ---
# DASH_METRICS=/var/lib/slotpin/metrics.jsonl   # slotpin's per-turn metric stream
# DASH_UPSTREAM=http://127.0.0.1:8080           # llama-server / Gufo address (live /slots)
# DASH_PROXY=127.0.0.1:8090                     # slotpin listen addr (health TCP check)
# DASH_ENERGY=http://192.0.2.10/metrics         # ESPHome whole-box energy scrape (default: off)
# DASH_SLOTPIN_CFG=/etc/slotpin/config.toml     # read live upstream_config_id label
# DASH_CFG=my-config-id                         # config id shown in the header (default: empty)

# --- rollup / windows ---
# DASH_DB=/var/lib/slotpin-dash/rollup.db        # 5-min bucket store (systemd StateDirectory)
# DASH_WINDOW_MIN=15                             # the "live" tail window, minutes
# DASH_POLL_SEC=3                                # live poll + rollup cadence, seconds
# DASH_STALL_S=300                               # busy+frozen this long with no completed turn => "stalled"

# --- temperature (CPU/GPU/NVMe via hwmon sysfs) ---
# DASH_HWMON=/sys/class/hwmon                    # hwmon root; reads k10temp/amdgpu/nvme temp1_input
# DASH_TEMP_WARN_C=85                            # card turns amber at/above this
# DASH_TEMP_CRIT_C=95                            # card turns red at/above this

# --- cross-box header nav (default: none) ---
# DASH_LABEL=box-a                               # this box's name; must match its own DASH_BOXES entry
# DASH_BOXES=box-a=http://box-a.example.com:8091,box-b=http://box-b.example.com:8091

# --- display ---
# Drafter name in the "Draft accept" card; default derived from the config id
# (MTP / DFlash2 / Draft).
# DASH_DRAFTER=MTP
