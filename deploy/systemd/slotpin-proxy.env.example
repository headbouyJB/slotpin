# Legacy SLOTPIN_* env-var overrides for slotpin-proxy, systemd EnvironmentFile
# style. Install as /etc/slotpin/slotpin.env (referenced by
# EnvironmentFile=-/etc/slotpin/slotpin.env in slotpin-proxy.service).
#
# Precedence: dataclass defaults < config.toml < these env vars.
# Booleans accept: on/off, 1/0, true/false.
#
# These seven names are short legacy aliases kept for systemd drop-in
# compatibility; every other
# config key can also be overridden via SLOTPIN_<UPPER_SNAKE_NAME> (see
# docs/configuration.md) but does not need an env override in normal use --
# prefer config.toml for anything not already an operational env-flag habit.

# Routing mode: "single" (all traffic -> default_slot; required for -np 1 /
# MTP models) or "dual" (interactive lane -> interactive_slot, else
# default_slot).
SLOTPIN_MODE=single

# Disk-warmth save/restore of KV snapshots for the interactive lane.
SLOTPIN_KV_PERSIST=on

# Generalises persist to any recurring workload via prefix-hash tracking.
SLOTPIN_KV_ADAPTIVE=on

# Priority scheduler (turn-boundary admission, strict tier priority,
# max_inflight=1).
SLOTPIN_SCHED=on

# MUST equal llama-server's own --cache-ram flag (MiB). A mismatch here is
# the single most common cause of "why are turns suddenly slow" -- see
# docs/operations.md's cache-ram lock-step rule.
SLOTPIN_CACHE_RAM_MB=2048

# Directory for slot KV snapshot files (<prefix_hash>.bin [+ .bin.ckpt]) and
# the latest_alias fallback file(s).
SLOTPIN_SLOT_SAVE_PATH=/var/lib/slotpin/kv-cache

# Per-turn + save/restore-event JSONL metrics file path.
SLOTPIN_METRICS=/var/lib/slotpin/metrics.jsonl
